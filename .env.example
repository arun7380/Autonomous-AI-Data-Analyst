# Application Environment Configs
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Autonomous AI Data Analyst"
API_V1_STR=/api/v1
# Security & JWT
SECRET_KEY=change_this_to_a_secure_32_byte_secret_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Database Connections
POSTGRES_SERVER=postgres
POSTGRES_USER=analyst_user
POSTGRES_PASSWORD=analyst_password_secret
POSTGRES_DB=autonomous_analyst_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
# DuckDB Persistent Path (or :memory:)
DUCKDB_PATH=/tmp/duckdb_store.db
# Redis & Celery Task Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2
# AI Models & LLM Credentials (Google Gemini & Groq)
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_PROVIDER=google
DEFAULT_MODEL_NAME=gemini-1.5-pro
FAST_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=models/text-embedding-004
# MLflow Tracking
MLFLOW_TRACKING_URI=http://mlflow:5000
# File Storage Configs
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE_MB=500
ALLOWED_EXTENSIONS=csv,xlsx,parquet,json,sqlite,db,sql